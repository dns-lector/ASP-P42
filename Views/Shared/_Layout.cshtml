@using System.Security.Claims
@{
    // перевіряємо авторизацію - вилучаємо з контексту дані за 
    // ключем "userAccessId"
    // UserAccess? userAccess = null;
    // String authKey = "userAccessId";
    // if (Context.Items.Keys.Contains(authKey))
    // {
    //     userAccess = (UserAccess)Context.Items[authKey]!;
    // }

    // нова схема роботи - вилучення Claims
    bool isAuthenticated = Context.User.Identity?.IsAuthenticated ?? false;
    String? userName = isAuthenticated
    ? Context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value
    : null;
    String? userEmail = isAuthenticated
    ? Context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value
    : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASP-P42</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASP-P42.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ASP-P42</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" 
                               asp-area="" 
                               asp-controller="Home" 
                               asp-action="Razor">Razor</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" 
                               asp-area="" 
                               asp-controller="Home" 
                               asp-action="IoC">IoC</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" 
                               asp-area="" 
                               asp-controller="Home" 
                               asp-action="Models">Model</a>
                        </li>

                    </ul>
                    
                    @if(!isAuthenticated)
                    {
                        <!-- Button trigger modal -->
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-toggle="modal" data-bs-target="#authModal">
                            Вхід
                        </button>
                    }
                    else
                    {
                        @*Д.З. Додати "аватарку" користувача за умови, що 
                            він авторизований у системі. Аватарка складається
                            з першої літери логіна у кружечку (реалізувати стилями)
                            Літера у верхньому реєстрі (велика), навіть якщо
                            логін починається з маленької.
                            При наведенні на неї спливає підказка з повним
                            іменем користувача та його E-mail
                        *@
                        <a class="btn btn-outline-danger"
                            title="@userName"
                            href="?logout">Вихід</a>
                    }    

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ASP-P42 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Modal -->
    <div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="authModalLabel">Автентифікація</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="auth-form">
                        <div class="mb-3">
                            <label for="auth-login" class="form-label">Логін</label>
                            <input name="auth-login" type="text" class="form-control" 
                                id="auth-login" placeholder="Логін"/>
                        </div>
                        <div class="mb-3">
                            <label for="auth-password" class="form-label">Пароль</label>
                            <input name="auth-password" type="password" class="form-control" 
                                id="auth-password" placeholder="********"/>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <div id="auth-modal-error"
                        style="visibility:hidden"
                        class="alert alert-danger py-2 flex-grow-1 text-center" 
                        role="alert"></div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" form="auth-form" class="btn btn-primary">Вхід</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
